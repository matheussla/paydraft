{
  "name": "paydraft",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @paydraft/web dev",
    "dev:api": "pnpm --filter @paydraft/api dev",
    "build:web": "pnpm --filter @paydraft/web build",
    "build:api": "pnpm --filter @paydraft/api build",
    "type-check": "pnpm -r --if-present type-check",
    "lint": "pnpm -r --if-present lint",
    "solana:keypairs": "pnpm --filter @paydraft/scripts solana:keypairs",
    "solana:init": "pnpm --filter @paydraft/scripts solana:init",
    "solana:health": "pnpm --filter @paydraft/scripts solana:health",
    "setup": "pnpm --filter @paydraft/scripts setup",
    "seed": "pnpm --filter @paydraft/scripts seed",
    "reset": "pnpm --filter @paydraft/scripts reset"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
